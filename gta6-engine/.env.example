# Copy to .env for local runs. In the cloud, set these as GitHub Actions secrets
# AND as Hugging Face Space secrets. Never commit real values.

# --- required for cloud ---
DATABASE_URL=postgresql+psycopg2://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DASHBOARD_TOKEN=            # REQUIRED, min 12 chars. Dashboard stays locked (503) without it
MEDIA_DIR=/tmp/gta6media
S3_BUCKET=gta6-media
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- optional: better content ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
DAILY_BUDGET_USD=0          # 0 = never call paid APIs. Raise only when YOU decide.
TTS_PROVIDER=edge           # edge (free neural voice) | silent
TTS_VOICE=en-IN-PrabhatNeural
YOUTUBE_API_KEY=            # trend research (free quota)
NEWS_RSS_FEEDS=https://www.gamespot.com/feeds/news/,https://feeds.feedburner.com/ign/news

# --- publishing (YouTube OAuth) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
REQUIRE_APPROVAL=true       # keep true until pipeline is proven
MAX_UPLOADS_PER_DAY=3
MAX_JOB_ATTEMPTS=3

# --- added in audit ---
PUBLIC_URL=https://<your-render-app>.onrender.com   # needed for "Connect YouTube" OAuth redirect
GH_DISPATCH_TOKEN=          # GitHub fine-grained token: ONLY this repo, permission Actions = Read and write
GH_REPO=ffrastogi737-art/Faltu
LLM_BASE_URL=               # optional FREE OpenAI-compatible LLM, e.g. https://api.groq.com/openai/v1 (verify its free tier yourself)
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_CALLS_PER_DAY=20
INLINE_WORKER=false         # keep false on the 512 MB free web host

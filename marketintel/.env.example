# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///marketintel.db
# DATABASE_URL=postgresql+psycopg://marketintel:change-me@db:5432/marketintel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
API_KEY=                      # required for watchlist changes when set; set it if the dashboard is reachable from the internet

ENABLE_YAHOO=true             # unofficial source, personal research use only
ENABLE_NSE_LISTS=true         # index constituent CSVs published by NSE
ENABLE_NSE_API=false          # FII/DII + holiday list from nseindia.com; enable only if you may use it
EXCHANGE=NSE                  # NSE or BSE
INDICES=NIFTY 500             # any of: NIFTY 50,NIFTY NEXT 50,NIFTY 500,NIFTY MIDCAP 150,NIFTY SMALLCAP 250
NEWS_FEEDS=                   # comma-separated RSS URLs you are allowed to read
HORIZON_DAYS=5
MIN_PROB=0.40
MIN_EDGE=0.08
COST_BPS=20

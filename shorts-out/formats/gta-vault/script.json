 "sources": [
  "Destructoid: how to unlock the secret Vault radio station in GTA 6 (scan the poster in The Vault with the WAiNK app)",
  "PowerPyx: GTA 6 Vault radio (Vice City Downtown, poster scan, tune in from a vehicle)",
  "Guides differ on the exact Vice City location; stated as per guides, not confirmed by Rockstar."
 ],
 "lines": [
  {
   "text": "A secret GTA 6 radio station that you unlock with your phone?"
  },
  {
   "text": "It's called The Vault, and it never shows up on the dial."
  },
  {
   "text": "Guides from Destructoid and PowerPyx say it starts in Vice City."
  },
  {
   "text": "There's a nightclub called The Vault, with a red poster of a mask."
  },
  {
   "text": "Open the WAiNK app on your in-game phone and scan that poster."
  },
  {
   "text": "Do that, and the station unlocks."
  },
  {
   "text": "Then hop in any vehicle and tune in."
  },
  {
   "text": "Guides say it plays electronic and rave music."
  },
  {
   "text": "They disagree on the exact spot, so check your map first."
  },
  {
   "text": "So tell us below, have you found"
  }
 ],
